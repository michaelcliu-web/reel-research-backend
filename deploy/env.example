# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=PRODUCTION
DISABLE_COLLECTSTATIC=1
USE_POSTGRES=TRUE
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-superuser-password-here

# Database (for RDS PostgreSQL)
DATABASE_URL=postgres://postgres:your-db-password-here@myapp-db.xxxxx.us-east-2.rds.amazonaws.com:5432/myapp
DB_NAME=myapp
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=myapp-db.xxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432

# Clerk (Production)
CLERK_FRONTEND_API=clerk.example.com
CLERK_SECRET_KEY=your-clerk-secret-key-here

# Stripe
STRIPE_PUBLIC_KEY=your-stripe-public-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Frontend URL
FRONTEND_URL=https://app.example.com

# LLM / API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Google OAuth (Production - matches Clerk social connection config)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
